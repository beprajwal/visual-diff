# The published package is the prebuilt dist/ (including the self-contained report UI bundle)
# plus the README. Everything below is development-only.
#
# Note: package.json "files" is the authority when both are present; this file mirrors it so the
# intent stays readable and `npm pack` behaves the same if "files" is ever removed.

src/
tests/
fixtures/
scripts/
docs/
.superpowers/
.visual-diff/

tsconfig.json
tsconfig.test.json
vitest.config.ts

*.test.ts
*.test.tsx
*.tsbuildinfo

# Sourcemaps and declaration maps point at `src/`, which is never published, so in the tarball they
# are dead weight — roughly half the file count. `.d.ts` stays: the package has a library export.
*.js.map
*.d.ts.map

.git/
.github/
.vscode/
.idea/
coverage/
node_modules/
.DS_Store
