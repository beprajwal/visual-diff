{
  /* Type-checks everything, including colocated *.test.ts and the tests/ tree.
     Emit-only settings from tsconfig.json are neutralized: this config never emits. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "fixtures"]
}
