{
  "name": "@beprajwal/visual-diff",
  "version": "0.5.2",
  "description": "Replay an agent-authored UI workflow across revisions, diff the results visually and semantically, and review them in a live local report.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beprajwal/visual-diff.git"
  },
  "homepage": "https://github.com/beprajwal/visual-diff#readme",
  "bugs": {
    "url": "https://github.com/beprajwal/visual-diff/issues"
  },
  "type": "module",
  "bin": {
    "vdiff": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist/skills",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:ui && pnpm run build:skills && pnpm run build:bin",
    "clean": "node scripts/clean.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:bin": "node scripts/finalize-bin.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src",
    "test:slow": "vitest run --config tests/slow/vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "pnpm run build",
    "version": "node scripts/sync-version.mjs && git add src/version.ts action.yml"
  },
  "keywords": [
    "visual-diff",
    "visual-regression",
    "playwright",
    "screenshot",
    "ui-diff",
    "agent"
  ],
  "dependencies": {
    "chokidar": "^4.0.3",
    "jpeg-js": "^0.4.4",
    "pixelmatch": "^6.0.0",
    "playwright-core": "^1.49.0",
    "pngjs": "^7.0.0",
    "preact": "^10.25.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.25.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
